# Скопируйте в .env и при необходимости поменяйте значения.
# Без ANTHROPIC_API_KEY и TELEGRAM_BOT_TOKEN система работает: ИИ — в mock-режиме, бот выключен.

# База. В docker compose переопределяется на адрес контейнера db.
# Для локального запуска без Docker: sqlite+aiosqlite:///./naryad.db
DATABASE_URL=postgresql+asyncpg://naryad:naryad@localhost:5432/naryad

# Подпись JWT — обязательно замените на сервере (например, `openssl rand -hex 32`).
JWT_SECRET=dev-only-secret-change-me-on-the-server-0000

# Демо-режим: пульт /demo, сброс сцены, короткие сроки.
DEMO_MODE=true

# ИИ. Пусто — mock-режим на правилах и шаблонах.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_FAST_MODEL=claude-haiku-4-5-20251001

# Telegram-бот (@BotFather). Пусто — бот не запускается, уведомления идут только в PWA.
TELEGRAM_BOT_TOKEN=

# Публичный адрес системы (ссылки в Telegram, QR-коды входа).
PUBLIC_URL=http://localhost

# Адрес для Caddy: ":80" локально, "naryad.example.kz" на сервере — HTTPS выпустится сам.
SITE_ADDRESS=:80
